# 카카오 REST API 키 (백엔드 KAKAO_CLIENT_ID와 같은 값)
VITE_KAKAO_REST_KEY=
# 카카오 JavaScript 키 (지도 SDK용)
VITE_KAKAO_JS_KEY= 
# 카카오 콘솔과 백엔드 KAKAO_REDIRECT_URI에 등록한 값과 정확히 같아야 한다
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
# 로컬 백엔드 주소 (macOS에서는 5000번을 AirPlay가 쓰므로 BE를 다른 포트로 띄우면 여기를 바꾼다)
VITE_API_PROXY=http://127.0.0.1:5000
